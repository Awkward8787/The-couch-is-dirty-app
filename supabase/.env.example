# Supabase — copy to .env and fill in values
# Never commit .env to version control

# From Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From Supabase Dashboard → Project Settings → Database
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Official podcast RSS feed (public)
RSS_FEED_URL=https://media.rss.com/the-couch-is-dirty-podcast/feed.xml

# Optional: APNs for push notifications (Edge Function)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tcidpodcast.app
APNS_PRIVATE_KEY=

# Admin dashboard (Next.js on Vercel)
ADMIN_ALLOWED_EMAILS=owner@tcidpodcast.com
