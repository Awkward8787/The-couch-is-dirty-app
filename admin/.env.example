# Admin Dashboard — copy to .env.local
# Never commit .env.local to version control

# Appwrite (self-hosted) — same project as iOS app
APPWRITE_ENDPOINT=https://api.tcidpodcast.com/v1
APPWRITE_PROJECT_ID=tcidpodcast
# Server-only API key for admin operations (create in Appwrite Console)
APPWRITE_API_KEY=your-server-api-key
APPWRITE_DATABASE_ID=episodes

# Comma-separated admin emails allowed to sign in (Appwrite Account email)
ADMIN_ALLOWED_EMAILS=anthony@vibevirtue.com

# App URL for auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3001
